{
  "id": "remotehand.system-monitor",
  "name": "RemoteHand System Monitor",
  "version": "0.5.1",
  "apiVersion": 1,
  "author": "RemoteHand",
  "description": "Local CPU, memory, GPU, disk, and process monitoring for RemoteHand.",
  "runtime": {
    "kind": "executable",
    "entrypoints": {
      "windows-x86_64": "bin/windows-x86_64/remotehand-system-monitor.exe"
    }
  },
  "permissions": [
    "files.open",
    "files.save",
    "clipboard.write",
    "storage.plugin",
    "tray.contribute",
    "notifications.show"
  ],
  "contributes": {
    "sidebar": [
      {
        "id": "system-monitor",
        "title": "System Monitor",
        "icon": "assets/sidebar.svg",
        "panel": "system-monitor"
      }
    ],
    "panels": [
      {
        "id": "system-monitor",
        "title": "System Monitor",
        "entry": "ui/index.html"
      }
    ],
    "commands": [
      {
        "id": "open",
        "title": "Open System Monitor"
      }
    ]
  }
}
